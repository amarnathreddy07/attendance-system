# Frontend configuration. Copy to .env and fill in real values.
# Vite exposes only VITE_* variables to the browser — nothing secret belongs
# here. The Google client id is public by design; authorisation is enforced by
# the Apps Script backend against the Teachers sheet.

# Google OAuth web client id (APIs & Services -> Credentials).
# Must match the GOOGLE_CLIENT_ID Script Property on the Apps Script backend.
VITE_GOOGLE_CLIENT_ID=

# Apps Script Web App deployment URL.
# Deploy -> Manage deployments -> Web app URL.
VITE_API_URL=

# Optional: override the base path when building for a subpath.
# BASE_PATH=/attendance-system/
